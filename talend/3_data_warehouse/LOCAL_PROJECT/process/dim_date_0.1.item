    <nodeData xsi:type="TalendMapper:MapperData">
      <uiProperties shellMaximized="true"/>
      <varTables sizeState="INTERMEDIATE" name="Var" minimized="true"/>
      <outputTables sizeState="INTERMEDIATE" name="out1">
        <mapperTableEntries name="id_date" expression="TalendDate.formatDate(&quot;yyyy-MM-dd&quot;, row1.current_date)" type="id_String" nullable="true"/>
        <mapperTableEntries name="jour" expression="row1.current_date.getDate()" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="mois" expression="row1.current_date.getMonth() + 1" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="annee" expression="row1.current_date.getYear() + 1900" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="trimestre" expression="(row1.current_date.getMonth() / 3) + 1" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="semaine" expression="Integer.parseInt(TalendDate.formatDate(&quot;ww&quot;, row1.current_date)) == 0 ? 52 : Integer.parseInt(TalendDate.formatDate(&quot;ww&quot;, row1.current_date)) " type="id_Integer" nullable="true"/>
        <mapperTableEntries name="jour_semaine" expression="TalendDate.formatDate(&quot;E&quot;, row1.current_date) " type="id_String" nullable="true"/>
        <mapperTableEntries name="nom_mois" expression="Integer.parseInt(TalendDate.formatDate(&quot;MM&quot;, row1.current_date)) == 1 ? &quot;Janvier&quot; : Integer.parseInt(TalendDate.formatDate(&quot;MM&quot;, row1.current_date)) == 2 ? &quot;Février&quot; : Integer.parseInt(TalendDate.formatDate(&quot;MM&quot;, row1.current_date)) == 3 ? &quot;Mars&quot; : Integer.parseInt(TalendDate.formatDate(&quot;MM&quot;, row1.current_date)) == 4 ? &quot;Avril&quot; : Integer.parseInt(TalendDate.formatDate(&quot;MM&quot;, row1.current_date)) == 5 ? &quot;Mai&quot; : Integer.parseInt(TalendDate.formatDate(&quot;MM&quot;, row1.current_date)) == 6 ? &quot;Juin&quot; : Integer.parseInt(TalendDate.formatDate(&quot;MM&quot;, row1.current_date)) == 7 ? &quot;Juillet&quot; : Integer.parseInt(TalendDate.formatDate(&quot;MM&quot;, row1.current_date)) == 8 ? &quot;Août&quot; : Integer.parseInt(TalendDate.formatDate(&quot;MM&quot;, row1.current_date)) == 9 ? &quot;Septembre&quot; : Integer.parseInt(TalendDate.formatDate(&quot;MM&quot;, row1.current_date)) == 10 ? &quot;Octobre&quot; : Integer.parseInt(TalendDate.formatDate(&quot;MM&quot;, row1.current_date)) == 11 ? &quot;Novembre&quot; : &quot;Décembre&quot; " type="id_String" nullable="true"/>
        <mapperTableEntries name="est_weekend" expression="Integer.parseInt(TalendDate.formatDate(&quot;u&quot;, row1.current_date)) == 6 || Integer.parseInt(TalendDate.formatDate(&quot;u&quot;, row1.current_date)) == 7 " type="id_Boolean" nullable="true"/>
        <mapperTableEntries name="jour_annee" expression="Integer.parseInt(TalendDate.formatDate(&quot;D&quot;, row1.current_date))" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="semaine_iso" expression="Integer.parseInt(TalendDate.formatDate(&quot;w&quot;, row1.current_date))" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="nom_jour_complet" expression="Integer.parseInt(TalendDate.formatDate(&quot;u&quot;, row1.current_date)) == 1 ? &quot;Lundi&quot; : Integer.parseInt(TalendDate.formatDate(&quot;u&quot;, row1.current_date)) == 2 ? &quot;Mardi&quot; : Integer.parseInt(TalendDate.formatDate(&quot;u&quot;, row1.current_date)) == 3 ? &quot;Mercredi&quot; : Integer.parseInt(TalendDate.formatDate(&quot;u&quot;, row1.current_date)) == 4 ? &quot;Jeudi&quot; : Integer.parseInt(TalendDate.formatDate(&quot;u&quot;, row1.current_date)) == 5 ? &quot;Vendredi&quot; : Integer.parseInt(TalendDate.formatDate(&quot;u&quot;, row1.current_date)) == 6 ? &quot;Samedi&quot; : &quot;Dimanche&quot; " type="id_String" nullable="true"/>
        <mapperTableEntries name="mois_annee" expression="Integer.parseInt(TalendDate.formatDate(&quot;MM&quot;, row1.current_date)) == 1 ? &quot;Janvier&quot; : Integer.parseInt(TalendDate.formatDate(&quot;MM&quot;, row1.current_date)) == 2 ? &quot;Février&quot; : Integer.parseInt(TalendDate.formatDate(&quot;MM&quot;, row1.current_date)) == 3 ? &quot;Mars&quot; : Integer.parseInt(TalendDate.formatDate(&quot;MM&quot;, row1.current_date)) == 4 ? &quot;Avril&quot; : Integer.parseInt(TalendDate.formatDate(&quot;MM&quot;, row1.current_date)) == 5 ? &quot;Mai&quot; : Integer.parseInt(TalendDate.formatDate(&quot;MM&quot;, row1.current_date)) == 6 ? &quot;Juin&quot; : Integer.parseInt(TalendDate.formatDate(&quot;MM&quot;, row1.current_date)) == 7 ? &quot;Juillet&quot; : Integer.parseInt(TalendDate.formatDate(&quot;MM&quot;, row1.current_date)) == 8 ? &quot;Août&quot; : Integer.parseInt(TalendDate.formatDate(&quot;MM&quot;, row1.current_date)) == 9 ? &quot;Septembre&quot; : Integer.parseInt(TalendDate.formatDate(&quot;MM&quot;, row1.current_date)) == 10 ? &quot;Octobre&quot; : Integer.parseInt(TalendDate.formatDate(&quot;MM&quot;, row1.current_date)) == 11 ? &quot;Novembre&quot; : &quot;Décembre&quot; + &quot; &quot; + Integer.parseInt(TalendDate.formatDate(&quot;yyyy&quot;, row1.current_date)) " type="id_String" nullable="true"/>
